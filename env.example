# Contact form email delivery (see src/app/api/contact/route.ts)
# All contact submissions are routed to CONTACT_TO_EMAIL (defaults to support@clonvo.chat).
CONTACT_TO_EMAIL=support@clonvo.chat

# ───── Option A: Resend (preferred for production) ──────────────────────────
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@clonvo.chat

# ───── Option B: Gmail SMTP (fallback, used when RESEND_API_KEY is unset) ───
GMAIL_USER=
GMAIL_APP_PASSWORD=
